generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum ProjectStatus {
  inprocess
  delivered
  rejected
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  STARTED
  IN_PROGRESS
  TESTING
  TESTED
  DEBUG
  FINISHED
  REJECTED
  COMPLETED
}

// =========================
// USER
// =========================

// =========================
// USER
// =========================

model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String
  department String?
  status     UserStatus @default(ACTIVE)

  // System-level administrator
  isAdmin Boolean @default(false)

  // Projects created by this user
  projects Project[]

  // Projects where this user is a member
  // Role is stored in ProjectMember
  projectMemberships ProjectMember[]

  // Tasks assigned to this user
  assignedTasks Task[]

  // Comments created by this user
  comments Comment[]

  // Audit logs created by this user
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// =========================
// ROLE
// =========================

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Project-specific roles
  projectMembers ProjectMember[]

  // Permissions assigned to this role
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// =========================
// PERMISSION
// =========================

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Roles having this permission
  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// =========================
// ROLE ↔ PERMISSION
// =========================

model RolePermission {
  roleId       Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =========================
// PROJECT
// =========================

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus

  // Original creator / owner
  createdBy Int

  user User @relation(fields: [createdBy], references: [id])

  // All project members
  // Project managers are also stored here
  members ProjectMember[]

  // Project tasks
  tasks Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdBy])
  @@index([status])
  @@map("projects")
}

// =========================
// PROJECT ↔ MEMBERS
// =========================

model ProjectMember {
  projectId Int
  userId    Int
  roleId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id])

  joinedAt DateTime @default(now())

  // One user can have only one role
  // inside the same project
  @@id([projectId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("project_members")
}

// =========================
// TASK
// =========================

// =========================
// TASK
// =========================

model Task {
  id           Int     @id @default(autoincrement())
  title        String
  description  String?
  projectId    Int
  assignedTo   Int
  parentTaskId Int?

  // Task information
  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)

  // Dynamic task category
  categoryId Int?

  category TaskCategoryItem? @relation(fields: [categoryId], references: [id])

  // Assignment / deadline
  assignedAt DateTime  @default(now())
  dueDate    DateTime?

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignee User @relation(fields: [assignedTo], references: [id], onDelete: Cascade)

  // Self relation for subtasks
  parentTask Task? @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)

  subtasks Task[] @relation("TaskSubtasks")

  // Task comments
  comments Comment[]

  // Task audit history
  auditLogs AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([assignedTo])
  @@index([parentTaskId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([dueDate])
  @@map("tasks")
}

// =========================
// TASK CATEGORY
// =========================

model TaskCategoryItem {
  id   Int    @id @default(autoincrement())
  name String

  // Parent category
  // null = top-level category
  parentCategoryId Int?

  parentCategory TaskCategoryItem? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)

  // Unlimited child/subcategories
  subcategories TaskCategoryItem[] @relation("CategoryHierarchy")

  // Tasks using this category
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentCategoryId])
  @@map("task_categories")
}

// =========================
// COMMENT
// =========================

model Comment {
  id          Int    @id @default(autoincrement())
  description String

  // User who created the comment
  userId Int

  // Task on which comment was made
  taskId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([taskId])
  @@map("comments")
}

// =========================
// AUDIT LOG
// =========================

model AuditLog {
  id Int @id @default(autoincrement())

  // Which task was changed
  taskId Int

  // Which user made the change
  userId Int

  // What field was changed
  // Example: status, priority, title, assignedTo, categoryId
  field String

  // Previous value
  oldValue String?

  // New value
  newValue String?

  // When the change happened
  createdAt DateTime @default(now())

  // User who made the change
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Task that was changed
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
