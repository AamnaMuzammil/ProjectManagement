generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum ProjectStatus {
  inprocess
  delivered
  rejected
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCategory {
  GENERIC
  SPECIFIC
}

enum TaskStatus {
  PENDING
  STARTED
  IN_PROGRESS
  TESTING
  TESTED
  DEBUG
  FINISHED
  REJECTED
  COMPLETED
}

// =========================
// USER
// =========================

model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String
  department String?
  status     UserStatus @default(ACTIVE)

  // Projects created by this user
  projects Project[]

  // Projects where this user is a member
  projectMemberships ProjectMember[]

  // Projects where this user is a manager
  managedProjects ProjectManager[]

  // Roles assigned to this user
  roles UserRole[]

  // Direct permissions assigned to this user
  permissions UserPermission[]

  // Tasks assigned to this user
  assignedTasks Task[]

  // Comments created by this user
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// =========================
// ROLE
// =========================

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// =========================
// PERMISSION
// =========================

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  roles RolePermission[]
  users UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// =========================
// USER ↔ ROLE
// =========================

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// =========================
// ROLE ↔ PERMISSION
// =========================

model RolePermission {
  roleId       Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =========================
// USER ↔ DIRECT PERMISSION
// =========================

model UserPermission {
  userId       Int
  permissionId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// =========================
// PROJECT
// =========================

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus

  // Original creator / owner
  createdBy Int

  user User @relation(fields: [createdBy], references: [id])

  // Multiple project managers
  managers ProjectManager[]

  // Project members
  members ProjectMember[]

  // Project tasks
  tasks Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdBy])
  @@index([status])
  @@map("projects")
}

// =========================
// PROJECT ↔ MANAGERS
// =========================

model ProjectManager {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_managers")
}

// =========================
// PROJECT ↔ MEMBERS
// =========================

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// =========================
// TASK
// =========================

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  projectId  Int
  assignedTo Int

  parentTaskId Int?

  // Task information
  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)
  category TaskCategory @default(GENERIC)

  // Assignment / deadline
  assignedAt DateTime  @default(now())
  dueDate    DateTime?

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignee User @relation(fields: [assignedTo], references: [id], onDelete: Cascade)

  // Self relation for subtasks
  parentTask Task? @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)

  subtasks Task[] @relation("TaskSubtasks")

  // Task comments
  comments Comment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([assignedTo])
  @@index([parentTaskId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([dueDate])
  @@map("tasks")
}

// =========================
// COMMENT
// =========================

model Comment {
  id          Int    @id @default(autoincrement())
  description String

  // User who created the comment
  userId Int

  // Task on which comment was made
  taskId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([taskId])
  @@map("comments")
}
