generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  inprocess
  delivered
  rejected
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String
  department String?
  status     UserStatus @default(ACTIVE)

  // Existing project creator relation
  projects Project[]

  // New: projects where user is a member
  projectMemberships ProjectMember[]

  // Existing RBAC relations
  roles       UserRole[]
  permissions UserPermission[]

  // Existing task relation
  assignedTasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  roles RolePermission[]
  users UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus

  // Project creator / manager
  createdBy Int

  // Existing relation - kept unchanged
  user User @relation(fields: [createdBy], references: [id])

  // New: multiple employees can work on project
  members ProjectMember[]

  // Existing relation - kept unchanged
  tasks Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdBy])
  @@map("projects")
}

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  projectId  Int
  assignedTo Int

  // New: optional parent task
  parentTaskId Int?

  // Existing relations - kept unchanged
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User    @relation(fields: [assignedTo], references: [id])

  // New: task/subtask self relation
  parentTask Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("TaskSubtasks")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([assignedTo])
  @@index([parentTaskId])
  @@map("tasks")
}
